  "sources": [
    {"id": "sklearn-model-persistence", "tool": "sklearn-persistence", "title": "Model persistence", "url": "https://scikit-learn.org/stable/model_persistence.html", "accessed": "2026-09-06", "claims": ["Pickle-based formats can execute arbitrary code when loaded.", "Loading a model trained with a different scikit-learn version is unsupported.", "ONNX is suggested when predictions are needed without the Python object, while skops.io offers a more secure Python-oriented format.", "Reproducibility guidance includes dependency versions and references to training data and source code."]},
    {"id": "joblib-load", "tool": "joblib", "title": "joblib.load API", "url": "https://joblib.readthedocs.io/en/stable/generated/joblib.load.html", "accessed": "2026-09-06", "claims": ["joblib.load relies on pickle, can execute arbitrary Python code, and must not load untrusted files."]},
    {"id": "joblib-persistence", "tool": "joblib", "title": "Persistence", "url": "https://joblib.readthedocs.io/en/stable/persistence.html", "accessed": "2026-09-06", "claims": ["Compatibility of joblib pickles across Python versions is not fully supported."]},
    {"id": "skops-persistence", "tool": "skops", "title": "Secure persistence with skops", "url": "https://skops.readthedocs.io/en/stable/persistence.html", "accessed": "2026-09-06", "claims": ["skops saves and loads sklearn models without pickle and checks types before constructing objects.", "Users can inspect untrusted types and visualize file structure before loading.", "skops supports most sklearn estimators but cannot persist arbitrary Python code.", "Cross-scikit-learn-version loading remains discouraged because skops cannot avoid sklearn compatibility behavior."]},
    {"id": "onnx-concepts", "tool": "onnx", "title": "ONNX concepts", "url": "https://onnx.ai/onnx/intro/concepts.html", "accessed": "2026-09-06", "claims": ["ONNX defines a common model language intended to make deployment independent of the training framework.", "An ONNX production environment needs a runtime for the serialized operator graph rather than the original training ecosystem.", "ONNX stores graph, operator-set versions, and optional model metadata; it does not represent every possible machine-learning operator."]},
    {"id": "pyod-persistence", "tool": "pyod", "title": "Model Save and Load", "url": "https://pyod.readthedocs.io/en/latest/model_persistence.html", "accessed": "2026-09-06", "claims": ["PyOD provides a versioned joblib envelope that records dependency versions and can warn or reject on drift.", "PyOD requires trusted=True because loading the envelope deserializes arbitrary Python code and is not sandboxed.", "Its metadata-returning load still unpickles the model; the documentation describes header-only inspection as a possible future API.", "Strict mode checks sklearn, joblib, numpy, and scipy versions."]},
    {"id": "mlflow-dependencies", "tool": "mlflow", "title": "Managing Dependencies in MLflow Models", "url": "https://mlflow.org/docs/latest/ml/model/dependencies/", "accessed": "2026-09-06", "claims": ["MLflow Models package model metadata and infer or accept dependency specifications for model environments."]},
    {"id": "mlflow-registry", "tool": "mlflow", "title": "Model Registry Workflows", "url": "https://mlflow.org/docs/latest/ml/model-registry/workflow/", "accessed": "2026-09-06", "claims": ["MLflow Model Registry manages registered model versions, aliases, tags, descriptions, source runs, and deployment organization."]},
    {"id": "dvc-guide", "tool": "dvc", "title": "DVC User Guide", "url": "https://dvc.org/doc/user-guide", "accessed": "2026-09-06", "claims": ["DVC provides Git-based data and model versioning, data pipelines, experiment management, and remote artifact storage workflows."]},
    {"id": "sigstore-overview", "tool": "sigstore", "title": "Sigstore Overview", "url": "https://docs.sigstore.dev/about/overview/", "accessed": "2026-09-06", "claims": ["Sigstore signs and verifies software artifacts, associates signatures with identities, and records signing events in a transparency log."]}
  ],
